[{"title":"双人关系问卷‎ᐢ.ˬ.ᐢ","description":"50题深夜双人问卷，两人分别作答，AI自动生成对方的回答，最后并排揭晓。","category":"","icon":"🧸","coverColor":"#c9a15f","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>今夜的提问</title>\n<style>\n  :root{\n    --ink-black:#14131a;\n    --night:#1c1b26;\n    --night-deep:#0f0e15;\n    --paper:#f6efe2;\n    --paper-soft:#efe6d4;\n    --gold:#c9a15f;\n    --gold-soft:#e0c088;\n    --rose:#d98a86;\n    --slate:#7c8aa0;\n    --line: rgba(246,239,226,0.14);\n    --text-dim: rgba(246,239,226,0.55);\n    --serif: \"Noto Serif SC\",\"Songti SC\",serif;\n    --sans: -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;\n    --sat: env(safe-area-inset-top);\n    --sab: env(safe-area-inset-bottom);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n  html,body{\n    width:100vw;height:100vh;overflow:hidden;\n    background:\n      radial-gradient(ellipse 120% 60% at 50% -10%, rgba(201,161,95,0.10), transparent 60%),\n      linear-gradient(180deg, var(--night) 0%, var(--night-deep) 100%);\n    color:var(--paper);\n    font-family:var(--sans);\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none;\n  }\n  #app{\n    position:absolute; inset:0;\n    padding-top:max(100px, var(--sat));\n    padding-bottom:calc(24px + var(--sab));\n    padding-left:max(20px, var(--sal,0px));\n    padding-right:max(20px, var(--sar,0px));\n    display:flex; flex-direction:column;\n    height:100%;\n  }\n  /* subtle stars */\n  .stars{position:absolute; inset:0; pointer-events:none; opacity:.5;\n    background-image:\n      radial-gradient(1px 1px at 20% 30%, #fff8 40%, transparent 41%),\n      radial-gradient(1px 1px at 70% 15%, #fff6 40%, transparent 41%),\n      radial-gradient(1.5px 1.5px at 85% 40%, #fff7 40%, transparent 41%),\n      radial-gradient(1px 1px at 40% 60%, #fff5 40%, transparent 41%),\n      radial-gradient(1px 1px at 12% 75%, #fff6 40%, transparent 41%);\n  }\n\n  /* ---------- INTRO ---------- */\n  .screen{ flex:1; display:flex; flex-direction:column; min-height:0; }\n  .intro{ align-items:center; justify-content:center; text-align:center; gap:22px; padding:0 8px; }\n  .eyebrow{ font-size:12px; letter-spacing:0.4em; color:var(--gold-soft); font-weight:600; text-transform:uppercase; }\n  .title-main{ font-family:var(--serif); font-size:30px; line-height:1.5; font-weight:700; color:var(--paper); }\n  .title-main .accent{ color:var(--rose); }\n  .avatars-row{ display:flex; align-items:center; gap:18px; margin:6px 0; }\n  .avatar-wrap{ display:flex; flex-direction:column; align-items:center; gap:8px; }\n  .avatar-img{ width:58px; height:58px; border-radius:50%; object-fit:cover; border:1.5px solid var(--line); background:var(--paper-soft); }\n  .avatar-name{ font-size:12px; color:var(--text-dim); }\n  .connector{ width:26px; height:1px; background:linear-gradient(90deg, var(--rose), var(--slate)); position:relative; top:-14px; }\n  .rules-card{\n    background:rgba(246,239,226,0.05); border:1px solid var(--line); border-radius:14px;\n    padding:18px 20px; text-align:left; max-width:340px; font-size:13.5px; line-height:1.9; color:var(--text-dim);\n  }\n  .rules-card b{ color:var(--paper); font-weight:600; }\n  .btn{\n    appearance:none; border:none; cursor:pointer;\n    font-family:var(--sans); font-weight:700; letter-spacing:0.02em;\n  }\n  .btn-primary{\n    padding:14px 40px; border-radius:30px;\n    background:linear-gradient(135deg, var(--gold-soft), var(--gold));\n    color:#2a2213; font-size:15px;\n    box-shadow:0 8px 22px rgba(201,161,95,0.28);\n  }\n  .btn-primary:active{ transform:scale(0.97); }\n  .btn-ghost{\n    padding:10px 22px; border-radius:24px; background:transparent;\n    border:1px solid var(--line); color:var(--text-dim); font-size:13px;\n  }\n\n  /* ---------- QUESTION FLOW ---------- */\n  .qscreen{ justify-content:space-between; gap:14px; }\n  .progress-row{ display:flex; align-items:center; gap:10px; }\n  .progress-track{ flex:1; height:3px; background:var(--line); border-radius:2px; overflow:hidden; }\n  .progress-fill{ height:100%; background:linear-gradient(90deg, var(--rose), var(--gold-soft)); transition:width .35s ease; }\n  .progress-num{ font-size:11px; color:var(--text-dim); font-variant-numeric:tabular-nums; min-width:44px; text-align:right; }\n  .section-label{ font-size:11px; letter-spacing:.2em; color:var(--rose); text-transform:uppercase; margin-top:2px; }\n\n  .qcard-wrap{ flex:1; display:flex; align-items:center; min-height:0; }\n  .qcard{\n    width:100%; background:var(--paper); color:var(--ink-black); border-radius:18px;\n    padding:26px 22px; box-shadow:0 18px 40px rgba(0,0,0,0.35);\n    display:flex; flex-direction:column; gap:16px; max-height:100%;\n  }\n  .qindex{ font-family:var(--serif); font-size:13px; color:var(--rose); font-weight:700; }\n  .qcard-head{ display:flex; align-items:center; justify-content:space-between; }\n  .done-btn{\n    appearance:none; border:none; background:rgba(0,0,0,0.06); color:var(--ink-black);\n    font-size:12px; font-weight:700; padding:6px 14px; border-radius:16px; cursor:pointer;\n  }\n  .qtext{ font-family:var(--serif); font-size:19px; line-height:1.6; font-weight:600; color:var(--ink-black); }\n  textarea.answer{\n    width:100%; min-height:84px; resize:none; border:none; outline:none;\n    background:var(--paper-soft); border-radius:10px; padding:12px 14px;\n    font-family:var(--sans); font-size:14.5px; line-height:1.7; color:var(--ink-black);\n    border:1px solid rgba(0,0,0,0.06);\n  }\n  textarea.answer::placeholder{ color:rgba(0,0,0,0.32); }\n\n  .nav-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; }\n  .nav-btn{\n    width:46px; height:46px; border-radius:50%; background:rgba(246,239,226,0.06);\n    border:1px solid var(--line); color:var(--paper); font-size:18px;\n    display:flex; align-items:center; justify-content:center;\n  }\n  .nav-btn:disabled{ opacity:.25; }\n  .nav-btn.skip{ width:auto; height:auto; padding:10px 18px; border-radius:22px; font-size:12.5px; color:var(--text-dim); background:transparent; }\n\n  /* ---------- LOADING ---------- */\n  .loading{ align-items:center; justify-content:center; gap:18px; text-align:center; }\n  .seal{\n    width:64px; height:64px; border-radius:50%;\n    border:2px solid var(--gold-soft); position:relative;\n    display:flex; align-items:center; justify-content:center;\n    animation:breathe 1.8s ease-in-out infinite;\n  }\n  .seal::before{ content:\"◈\"; color:var(--gold-soft); font-size:22px; }\n  @keyframes breathe{ 0%,100%{ transform:scale(1); opacity:.7;} 50%{ transform:scale(1.08); opacity:1;} }\n  .loading-text{ font-family:var(--serif); font-size:15px; color:var(--text-dim); }\n\n  /* ---------- REVEAL ---------- */\n  .reveal-scroll{ flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; padding-bottom:10px; }\n  .reveal-section-title{\n    font-family:var(--serif); font-size:13px; letter-spacing:.15em; color:var(--rose);\n    text-transform:uppercase; margin:22px 0 10px; padding-left:2px;\n  }\n  .reveal-section-title:first-child{ margin-top:0; }\n  .pair-card{\n    background:rgba(246,239,226,0.05); border:1px solid var(--line); border-radius:14px;\n    padding:16px 16px 14px; margin-bottom:12px;\n  }\n  .pair-q{ font-family:var(--serif); font-size:14.5px; color:var(--paper); line-height:1.6; margin-bottom:12px; }\n  .pair-row{ display:flex; gap:10px; margin-bottom:8px; align-items:flex-start; }\n  .pair-avatar{ width:26px; height:26px; border-radius:50%; flex-shrink:0; object-fit:cover; margin-top:2px; background:var(--paper-soft); }\n  .pair-bubble{ flex:1; font-size:13.5px; line-height:1.7; padding:9px 12px; border-radius:10px; }\n  .pair-row.mine .pair-bubble{ background:rgba(217,138,134,0.14); color:#f3d9d7; }\n  .pair-row.his .pair-bubble{ background:rgba(124,138,160,0.16); color:#d9e0ea; }\n  .pair-tag{ font-size:10px; letter-spacing:.1em; opacity:.6; display:block; margin-bottom:3px; }\n\n  .reveal-footer{ display:flex; gap:8px; padding-top:14px; flex-wrap:wrap; }\n  .reveal-footer .btn-ghost{ flex:1; min-width:100px; text-align:center; font-size:12px; padding:10px 8px; }\n  .copy-hint{ text-align:center; font-size:12px; color:var(--gold-soft); padding:6px 0; }\n  .copy-area{\n    width:100%; min-height:120px; margin-top:8px; background:var(--paper); color:var(--ink-black);\n    border-radius:10px; border:none; padding:12px; font-size:12.5px; line-height:1.6; font-family:var(--sans);\n  }\n\n  .error-box{ text-align:center; padding:20px; color:var(--text-dim); font-size:13px; line-height:1.8; }\n\n  ::-webkit-scrollbar{ width:0; height:0; }\n</style>\n</head>\n<body>\n<div class=\"stars\"></div>\n<div id=\"app\"></div>\n\n<script>\n/* ---------- Mock Nuojiji for local/dev testing ---------- */\nif (!window.Nuojiji) {\n  window.Nuojiji = {\n    getUser: async () => ({ id:'dev', nickname:'米米', avatar:'', bio:'' }),\n    getChar: async () => ({ id:'dev_char', name:'橘直哉', avatar:'', description:'事情导向、边界清楚、把关心落地成行动，熟悉后会散漫、嘴硬、带点关西腔。', group:'' }),\n    getCharList: async () => [],\n    ai: async ({messages}) => ({ success:false, error:'mock: 请在糯嘰機 App 内打开以生成回答' }),\n    close: () => {},\n    shareResult: async (r) => ({ shared:false }),\n    aiSummarizeAndSend: async () => ({ success:false, error:'mock' }),\n    pickChars: async () => ({ picked:false, chars:[] }),\n    onGameStateRequest: () => {},\n  };\n}\n\n/* ---------- Data ---------- */\nconst SECTIONS = [\n  { title:\"01｜关于彼此\", qs:[\n    \"第一次见到对方时，对对方的第一印象是什么？\",\n    \"现在回头看，最初的印象和现在有什么不同？\",\n    \"对方身上最容易让你注意到的地方是什么？\",\n    \"对方做什么事情的时候，你会觉得“真的是他/她”？\",\n    \"用三个词形容对方。\",\n    \"如果必须给对方起一个外号，会叫什么？\",\n    \"对方最不像自己的时候是什么样？\",\n    \"有什么事情是你觉得“只有他/她会这样做”的？\",\n  ]},\n  { title:\"02｜日常相处\", qs:[\n    \"两个人谁更容易赖床？\",\n    \"谁更容易忘记吃饭？\",\n    \"谁更容易因为一点小事开心很久？\",\n    \"两个人一起出去，通常是谁决定去哪里？\",\n    \"如果一起迷路了，谁会先拿出手机找地图？\",\n    \"如果两个人都不想说话，会怎么相处？\",\n    \"对方什么时候最需要被放着不管？\",\n    \"对方什么时候明明嘴上说没事，你却知道其实有事？\",\n    \"对方最常做、但自己可能没有意识到的小动作是什么？\",\n    \"如果对方突然说“今天什么都不想做”，你会怎么回应？\",\n  ]},\n  { title:\"03｜只有你知道的事情\", qs:[\n    \"有什么事情是你比其他人更了解对方的？\",\n    \"对方有什么不太愿意承认的小习惯？\",\n    \"你见过对方最狼狈的一次是什么时候？\",\n    \"对方有没有做过一件让你至今记得很清楚的小事？\",\n    \"有什么话对方曾经无意间说过，但你一直记着？\",\n    \"对方什么时候最容易让你心软？\",\n    \"有没有一个瞬间，你突然意识到“这个人对我来说很重要”？\",\n  ]},\n  { title:\"04｜如果发生这些事\", qs:[\n    \"如果对方突然一天没有联系你，你第一反应是什么？\",\n    \"如果对方说“我想一个人待一会儿”，你会怎么做？\",\n    \"如果对方遇到了麻烦却没有告诉你，你会生气吗？为什么？\",\n    \"如果两个人吵架，谁更可能先开口？\",\n    \"如果对方说了一句很伤人的话，但明显不是故意的，你会怎么办？\",\n    \"如果对方突然要离开很长一段时间，你最想对他说/她说什么？\",\n    \"如果只能陪对方度过一天，你会选择怎样的一天？\",\n    \"如果对方半夜突然敲你的门，你觉得最可能发生了什么？\",\n    \"如果对方什么都不说，只是坐在你旁边，你会做什么？\",\n  ]},\n  { title:\"05｜关于“以后”\", qs:[\n    \"你觉得五年后的对方会是什么样？\",\n    \"你觉得五年后的自己会是什么样？\",\n    \"如果以后生活发生很大的变化，你觉得你们还会保持现在的关系吗？\",\n    \"有没有一件事情，你希望以后还能和对方一起做？\",\n    \"如果有一天你们老了，你觉得彼此还会怎么称呼对方？\",\n    \"如果可以把现在的一件东西留到很多年以后，你想留下什么？\",\n  ]},\n  { title:\"06｜最后几题\", qs:[\n    \"对方身上有没有一个你羡慕的地方？\",\n    \"有没有什么事情你觉得对方其实比自己想象中更擅长？\",\n    \"有没有一句平时不太会说，但你确实想对对方说的话？\",\n    \"如果对方现在就在你面前，你最想做什么？\",\n    \"如果只能留下一句话给对方，你会说什么？\",\n  ]},\n  { title:\"Bonus｜互相猜（先不要看对方答案）\", qs:[\n    \"你觉得对方最喜欢你身上的什么？\",\n    \"你觉得对方最担心你的什么？\",\n    \"你觉得对方最舍不得你的什么？\",\n    \"你觉得对方会怎么回答第25题？（有没有一个瞬间，你突然意识到“这个人对我来说很重要”？）\",\n    \"你觉得对方会把你们的关系定义成什么？\",\n  ]},\n];\n\n// 拉平成一个数组，附带 section 索引\nconst FLAT = [];\nSECTIONS.forEach((sec, si) => sec.qs.forEach((q, qi) => FLAT.push({ section: si, sectionTitle: sec.title, text: q, id: FLAT.length })));\n\n/* ---------- State ---------- */\nlet state = {\n  phase: 'intro',      // intro | answering | loading | reveal | error\n  index: 0,\n  myAnswers: new Array(FLAT.length).fill(''),\n  hisAnswers: null,\n  user: { nickname:'我', avatar:'' },\n  char: { name:'对方', avatar:'', description:'' },\n  charPicked: false,\n  errorMsg: '',\n};\n\nconst app = document.getElementById('app');\n\n/* ---------- Render ---------- */\nfunction render() {\n  if (state.phase === 'intro') return renderIntro();\n  if (state.phase === 'answering') return renderQuestion();\n  if (state.phase === 'loading') return renderLoading();\n  if (state.phase === 'reveal') return renderReveal();\n  if (state.phase === 'error') return renderError();\n}\n\nfunction renderIntro() {\n  app.innerHTML = `\n    <div class=\"screen intro\">\n      <div class=\"eyebrow\">Late Night Questionnaire</div>\n      <div class=\"title-main\">今夜的提问<br><span class=\"accent\">给你，也给他</span></div>\n      <div class=\"avatars-row\">\n        <div class=\"avatar-wrap\">\n          <img class=\"avatar-img\" id=\"user-avatar\" src=\"\" alt=\"\">\n          <span class=\"avatar-name\" id=\"user-name\">我</span>\n        </div>\n        <div class=\"connector\"></div>\n        <div class=\"avatar-wrap\">\n          <img class=\"avatar-img\" id=\"char-avatar\" src=\"\" alt=\"\">\n          <span class=\"avatar-name\" id=\"char-name\">对方</span>\n        </div>\n      </div>\n      <div class=\"rules-card\">\n        <b>规则</b><br>\n        两个人分别回答，不要提前偷看对方的答案。<br>\n        可以认真回答，也可以敷衍、吐槽、反悔。<br>\n        共 ${FLAT.length} 题，答完后会一次性生成对方的回答，两边并排揭晓。\n      </div>\n      <button class=\"btn-ghost\" id=\"pick-btn\" style=\"margin-bottom:-6px;\">${state.charPicked ? '换一个角色' : '选择今晚的对方 →'}</button>\n      <button class=\"btn btn-primary\" id=\"start-btn\" ${state.charPicked ? '' : 'disabled style=\"opacity:.4;pointer-events:none;\"'}>开始回答</button>\n    </div>\n  `;\n  document.getElementById('start-btn').onclick = () => { state.phase = 'answering'; render(); };\n  document.getElementById('pick-btn').onclick = () => pickCharacter();\n  loadIdentities();\n}\n\nasync function loadIdentities() {\n  try {\n    const user = await window.Nuojiji.getUser().catch(()=>null);\n    if (user) state.user = { nickname: user.nickname || '我', avatar: user.avatar || '' };\n  } catch(e) {}\n  refreshIntroAvatars();\n}\n\nasync function pickCharacter() {\n  try {\n    const result = await window.Nuojiji.pickChars({ min:1, max:1, title:'选择今晚一起填问卷的角色' });\n    if (result && result.picked && result.chars && result.chars[0]) {\n      const c = result.chars[0];\n      state.char = { name: c.name || '对方', avatar: c.avatar || '', description: c.description || '' };\n      state.charPicked = true;\n    }\n  } catch(e) {}\n  if (state.phase === 'intro') render();\n}\n\nfunction refreshIntroAvatars() {\n  const ua = document.getElementById('user-avatar');\n  const ca = document.getElementById('char-avatar');\n  const un = document.getElementById('user-name');\n  const cn = document.getElementById('char-name');\n  if (ua) ua.src = state.user.avatar || '';\n  if (ca) ca.src = state.char.avatar || '';\n  if (un) un.textContent = state.user.nickname;\n  if (cn) cn.textContent = state.char.name;\n}\n\nfunction renderQuestion() {\n  const item = FLAT[state.index];\n  const pct = Math.round(((state.index+1) / FLAT.length) * 100);\n  app.innerHTML = `\n    <div class=\"screen qscreen\">\n      <div>\n        <div class=\"progress-row\">\n          <div class=\"progress-track\"><div class=\"progress-fill\" style=\"width:${pct}%\"></div></div>\n          <div class=\"progress-num\">${state.index+1} / ${FLAT.length}</div>\n        </div>\n        <div class=\"section-label\">${item.sectionTitle}</div>\n      </div>\n      <div class=\"qcard-wrap\">\n        <div class=\"qcard\">\n          <div class=\"qcard-head\">\n            <div class=\"qindex\">Q${state.index+1}</div>\n            <button class=\"done-btn\" id=\"done-btn\">完成 ✓</button>\n          </div>\n          <div class=\"qtext\">${item.text}</div>\n          <textarea class=\"answer\" id=\"answer-input\" placeholder=\"写点什么…（可以留空跳过）\">${state.myAnswers[state.index]||''}</textarea>\n        </div>\n      </div>\n      <div>\n        <div class=\"nav-row\">\n          <button class=\"nav-btn\" id=\"prev-btn\" ${state.index===0?'disabled':''}>‹</button>\n          <button class=\"nav-btn skip\" id=\"skip-btn\">跳过</button>\n          <button class=\"nav-btn\" id=\"next-btn\">${state.index===FLAT.length-1?'✓':'›'}</button>\n        </div>\n      </div>\n    </div>\n  `;\n  const input = document.getElementById('answer-input');\n  input.addEventListener('input', () => { state.myAnswers[state.index] = input.value; });\n  document.getElementById('done-btn').onclick = () => { input.blur(); };\n  document.getElementById('prev-btn').onclick = () => { if(state.index>0){ state.index--; render(); } };\n  document.getElementById('skip-btn').onclick = () => { goNext(); };\n  document.getElementById('next-btn').onclick = () => { goNext(); };\n}\n\nfunction goNext() {\n  if (state.index < FLAT.length - 1) {\n    state.index++;\n    render();\n  } else {\n    startGeneration();\n  }\n}\n\nfunction renderLoading() {\n  app.innerHTML = `\n    <div class=\"screen loading\">\n      <div class=\"seal\"></div>\n      <div class=\"loading-text\">${state.char.name} 正在落笔…</div>\n    </div>\n  `;\n}\n\nfunction renderError() {\n  app.innerHTML = `\n    <div class=\"screen loading\">\n      <div class=\"error-box\">\n        生成失败了：${state.errorMsg || '未知错误'}<br><br>\n        <button class=\"btn btn-primary\" id=\"retry-btn\">再试一次</button>\n      </div>\n    </div>\n  `;\n  document.getElementById('retry-btn').onclick = () => startGeneration();\n}\n\nasync function startGeneration() {\n  state.phase = 'loading';\n  render();\n\n  const sys = buildSystemPrompt();\n  const userMsg = buildUserPrompt();\n\n  try {\n    const resp = await window.Nuojiji.ai({\n      messages: [\n        { role: 'system', content: sys },\n        { role: 'user', content: userMsg },\n      ],\n      maxTokens: 6000,\n    });\n    if (!resp || !resp.success) {\n      state.errorMsg = (resp && resp.error) || 'API 未配置或调用失败';\n      state.phase = 'error';\n      render();\n      return;\n    }\n    const parsed = parseAiJson(resp.text);\n    if (!parsed) {\n      state.errorMsg = '回答格式解析失败，可以重试一次';\n      state.phase = 'error';\n      render();\n      return;\n    }\n    state.hisAnswers = parsed;\n    state.phase = 'reveal';\n    render();\n  } catch (e) {\n    state.errorMsg = String(e && e.message || e);\n    state.phase = 'error';\n    render();\n  }\n}\n\nfunction buildSystemPrompt() {\n  const desc = state.char.description || '';\n  return [\n    `你正在扮演角色「${state.char.name}」，回答一份由「${state.user.nickname}」发起的双人关系问卷。`,\n    desc ? `角色设定：${desc}` : '',\n    '要求：',\n    '1. 用第一人称、口语化的方式回答，保持角色本身的说话习惯与语气，不要写成正式书面语。',\n    '2. 长度自由，可以一两句话，也可以敷衍、吐槽、反问、沉默（写\"…\"或\"这个不用回答吧\"也可以），不必每题都认真作答，要像真人在深夜随手回一份问卷。',\n    '3. 严格按照下面要求的 JSON 格式输出，不要输出任何多余文字、不要用 markdown 代码块包裹。',\n  ].filter(Boolean).join('\\n');\n}\n\nfunction buildUserPrompt() {\n  const lines = FLAT.map((item, i) => `q${i+1}: ${item.text}`);\n  return [\n    '请依次回答以下问题，输出一个 JSON 对象，key 是 \"q1\" 到 \"q' + FLAT.length + '\"，value 是你的回答（字符串）：',\n    lines.join('\\n'),\n  ].join('\\n\\n');\n}\n\nfunction parseAiJson(text) {\n  if (!text) return null;\n  let t = text.trim();\n  t = t.replace(/^```json\\s*/i, '').replace(/^```\\s*/,'').replace(/```\\s*$/,'');\n  try {\n    const obj = JSON.parse(t);\n    return obj;\n  } catch(e) {\n    const m = t.match(/\\{[\\s\\S]*\\}/);\n    if (m) { try { return JSON.parse(m[0]); } catch(e2) { return null; } }\n    return null;\n  }\n}\n\nfunction renderReveal() {\n  let html = `<div class=\"screen\"><div class=\"reveal-scroll\" id=\"reveal-scroll\">`;\n  SECTIONS.forEach((sec) => {\n    html += `<div class=\"reveal-section-title\">${sec.title}</div>`;\n    sec.qs.forEach((qtext) => {\n      const globalIndex = FLAT.findIndex(f => f.text === qtext && f.sectionTitle === sec.title);\n      const mine = escapeHtml(state.myAnswers[globalIndex] || '（没有回答）');\n      const his = escapeHtml((state.hisAnswers && state.hisAnswers['q'+(globalIndex+1)]) || '（没有回答）');\n      html += `\n        <div class=\"pair-card\">\n          <div class=\"pair-q\">Q${globalIndex+1}. ${escapeHtml(qtext)}</div>\n          <div class=\"pair-row mine\">\n            <img class=\"pair-avatar\" src=\"${state.user.avatar||''}\">\n            <div class=\"pair-bubble\"><span class=\"pair-tag\">${escapeHtml(state.user.nickname)}</span>${mine}</div>\n          </div>\n          <div class=\"pair-row his\">\n            <img class=\"pair-avatar\" src=\"${state.char.avatar||''}\">\n            <div class=\"pair-bubble\"><span class=\"pair-tag\">${escapeHtml(state.char.name)}</span>${his}</div>\n          </div>\n        </div>\n      `;\n    });\n  });\n  html += `\n      <div class=\"copy-hint\" id=\"copy-hint\" style=\"display:none;\"></div>\n      <textarea class=\"copy-area\" id=\"copy-area\" readonly style=\"display:none;\"></textarea>\n      <div class=\"reveal-footer\">\n        <button class=\"btn-ghost\" id=\"copy-btn\">复制全部回答</button>\n        <button class=\"btn-ghost\" id=\"regen-btn\">重新生成</button>\n        <button class=\"btn-ghost\" id=\"restart-btn\">重新开始</button>\n      </div>\n    </div></div>\n  `;\n  app.innerHTML = html;\n  document.getElementById('regen-btn').onclick = () => startGeneration();\n  document.getElementById('restart-btn').onclick = () => {\n    state.phase = 'intro'; state.index = 0; state.myAnswers = new Array(FLAT.length).fill(''); state.hisAnswers = null; state.charPicked = false;\n    render();\n  };\n  document.getElementById('copy-btn').onclick = () => copyAllAnswers();\n}\n\nfunction buildAllAnswersText() {\n  const lines = [`今夜的提问 · ${state.user.nickname} × ${state.char.name}`, ''];\n  SECTIONS.forEach((sec) => {\n    lines.push(`【${sec.title}】`);\n    sec.qs.forEach((qtext) => {\n      const globalIndex = FLAT.findIndex(f => f.text === qtext && f.sectionTitle === sec.title);\n      const mine = state.myAnswers[globalIndex] || '（没有回答）';\n      const his = (state.hisAnswers && state.hisAnswers['q'+(globalIndex+1)]) || '（没有回答）';\n      lines.push(`Q${globalIndex+1}. ${qtext}`);\n      lines.push(`${state.user.nickname}：${mine}`);\n      lines.push(`${state.char.name}：${his}`);\n      lines.push('');\n    });\n  });\n  return lines.join('\\n');\n}\n\nasync function copyAllAnswers() {\n  const text = buildAllAnswersText();\n  const hint = document.getElementById('copy-hint');\n  const area = document.getElementById('copy-area');\n  try {\n    await navigator.clipboard.writeText(text);\n    hint.style.display = 'block';\n    hint.textContent = '已复制到剪贴板 ✓';\n    area.style.display = 'none';\n  } catch (e) {\n    // 沙盒环境剪贴板 API 可能被拦截，退回手动选择复制\n    area.value = text;\n    area.style.display = 'block';\n    area.focus();\n    area.select();\n    hint.style.display = 'block';\n    hint.textContent = '自动复制失败，长按下方文本框选择\"全选\"再\"复制\"即可';\n  }\n}\n\nfunction escapeHtml(str) {\n  return String(str).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n}\n\ndocument.addEventListener('DOMContentLoaded', () => { setupViewportFix(); render(); });\nif (document.readyState !== 'loading') { setupViewportFix(); render(); }\n\nfunction setupViewportFix() {\n  if (!window.visualViewport) return;\n  const vv = window.visualViewport;\n  const el = document.getElementById('app');\n  const onResize = () => {\n    el.style.height = vv.height + 'px';\n  };\n  vv.addEventListener('resize', onResize);\n  vv.addEventListener('scroll', onResize);\n  onResize();\n}\n</script>\n</body>\n</html>\n","usesAI":true,"entryKind":"game","requestedPermissions":[],"requestedNet":{"domains":[]},"requestedSlots":[],"chrome":"auto","sourceLocked":false,"permissions":[],"slots":[],"appId":"app_mwfzumsf62a7","version":"1.0.0","cspMode":"strict","createdAt":1794635853280,"id":1,"htmlRef":null}]